@inproceedings{joshi_analyses_2022,
	title = {Analyses of Software Testing Approaches},
	doi = {10.1109/IIHC55949.2022.10060147},
	abstract = {Software testing is an essential part of the Software Development Lifecycle because of its importance both before and after code is written. As such, it necessitates the use of well-developed, well-executed processes and procedures. This article attempts to discuss both existing testing techniques and possible enhancements to those procedures in the sake of higher quality assurance. Extensive testing, including validation and verification, is required to guarantee that the software satisfies all clients' requirements. As a result, software development processes and testing strategies are made. However, software testing strategies provide a well-thought-out sequence of actions that should reliably yield results, as opposed to software testing approaches, which focus on how to test a specific feature or function. In this analysis, the advantages and disadvantages of various software testing strategies are explored. Furthermore, it specifies the basic life cycles that must be observed throughout quality assurance testing.},
	eventtitle = {2022 International Interdisciplinary Humanitarian Conference for Sustainability ({IIHC})},
	pages = {1276--1281},
	booktitle = {2022 International Interdisciplinary Humanitarian Conference for Sustainability ({IIHC})},
	author = {Joshi, Shalini and Kumari, Indra},
	urldate = {2026-05-04},
	date = {2022-11},
	keywords = {Computer bugs, Costs, methodologies and techniques, Process control, Quality assurance, Quality control, quality testing, Software, Software Development Lifecycle, Software testing},
	file = {Full Text PDF:C\:\\Users\\ssander\\Zotero\\storage\\UL5RXZMI\\Joshi and Kumari - 2022 - Analyses of Software Testing Approaches.pdf:application/pdf},
}

